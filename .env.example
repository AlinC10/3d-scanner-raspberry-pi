R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
GROQ_API_KEY=
R2_BUCKET=photogrammetry-pipeline

# Turntable Studio on RunPod (only for scans with cloud.launch_runpod = true; check with POST /test/cloud/runpod-dry-run)
# Cloudflare API token with "Workers R2 Storage: Edit": mints the pod's temporary R2 credentials (one job prefix only)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_API_TOKEN=your_cloudflare_api_token
RUNPOD_API_KEY=your_runpod_key
TURNTABLE_IMAGE=ghcr.io/<user>/turntable-studio:v1
# Optional: RUNPOD_REGISTRY_AUTH_ID (private image), RUNPOD_GPU_TYPES (comma list), RUNPOD_MAX_GPU_PRICE (1.10 $/h), RUNPOD_PREFERRED_VCPU (16), RUNPOD_PREFERRED_RAM_GB (48), RUNPOD_CLOUD_TYPE (SECURE),
# RUNPOD_POD_MAX_RUNTIME_S (3600), SCAN_R2_STALE_JOB_S (86400: old job folders deleted by a new prepare)
# Local face reconstruction (rpi_face_mesh): FACE_RECONSTRUCT_TIMEOUT_S (300), FACE_RECONSTRUCT_PYTHON (default: this venv)
# Buzzer (hardware/docs/BUZZER.md): BUZZER_GPIO_PIN (BCM, default 23; off = no sounds)
